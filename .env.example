# Copier ce fichier en `.env.local` pour surcharger ces valeurs en local
# (Vite charge automatiquement .env, puis .env.local par-dessus).

# URL de base de l'API back-end (RESTful, cf. cahier des charges §2).
VITE_API_BASE_URL=http://localhost:8080/api

# true  = les services utilisent les données mock (aucun back-end requis, mode démo actuel)
# false = les services appellent réellement VITE_API_BASE_URL via axios
VITE_USE_MOCK=true
